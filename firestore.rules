rules_version = '2';

// The security boundary of the entire application.
//
// There is no server, so there is no code path that checks permission before a
// read. This file IS the check. If it is wrong, every signed-in person can read
// everyone else's fuel log, and nothing else in the codebase would notice.
//
// The data is laid out as users/{uid}/... (see firebase/remoteStore.ts)
// specifically so that one identity check covers every collection. The common
// alternative — top-level collections with an ownerId field — needs a rule per
// collection plus a matching constraint on every query, and that is one clause
// more than fits in a reader's head, which is how this class of app leaks data.
//
// Everything not matched here is denied: Firestore's default is deny, and there
// is no catch-all allow anywhere below.
//
// ## One written exception: a shared car (#66)
//
// "Your own tree, nobody else's" has exactly one exception. An owner can share
// one car, and the accounts listed under that car's `members` subcollection
// can read it, and read and write **its** fill-ups — in the owner's tree,
// where the car stays. Nothing else in the owner's tree becomes visible: not
// their other cars, not other cars' fill-ups, not pending submissions. A
// member joins only by accepting an invite addressed to their own verified
// Google email; nobody can add anybody else.
//
// ## Two jobs, not one
//
// Identity — "is this your tree?" — was the only question this file used to
// ask. That is enough to stop another *user*, and useless against a bad build,
// a half-finished write, or a hand edit in the console. So writes now also have
// to be the right shape.
//
// It is defence in depth rather than the primary check: recordValidation.ts
// re-checks everything on read, because a document can predate any rule. What
// the rules add is a limit on what can get *in*, including the size limits that
// keep one bad write from eating a day's quota or the 1 GiB allowance.
//
// ## Adding a field means editing this file first
//
// `hasOnly` means an unknown field is refused. That is the point — it is what
// stops a junk field being inflated to the 1 MiB document cap — but it couples
// the schema to these rules. A new field must be deployed here *before* a build
// that writes it, or writes fail until it is. Change both in the same pull
// request.
service cloud.firestore {
  match /databases/{database}/documents {

    // The accounts allowed to use this deployment at all.
    //
    // Google sign-in is open to every Google account on earth, and until #27
    // that was enough to get in: the rules confined a stranger to their own
    // tree and then let them write in it freely — on this project's quota,
    // inside its 1 GiB, invisible to the owner, because nobody can see
    // anybody else's tree. Being bounded to your own corner is not the same
    // as being allowed through the door.
    //
    // A list of uids rather than emails or a document to look up, for three
    // reasons. A uid is opaque, so this file stays free of anybody's
    // personal data even though the repository is public. A list literal
    // costs nothing to evaluate, where an `exists()` against an allowlist
    // document would add a billed read to **every** request — a strange
    // thing to spend on a rule about quota. And a list a reader can see is a
    // list a reviewer can check.
    //
    // The cost, stated: adding somebody is a deploy of this file, and their
    // uid only exists once they have signed in and been refused once.
    // `docs/accounts.md` has the steps.
    function allowed() {
      return request.auth != null && request.auth.uid in [
        'Vz0Y9I7XU0TX6L1yvfzw8BJnIfG2',
        'h2VnTaHnwnWWF4gtPvXTQcJcGAC2'
      ];
    }

    // A member of `owner`'s car `vehicleId` (#66): an allowlisted account with
    // a document under that car's `members`. One billed `exists()` per check —
    // only ever spent on a request that is not the owner's own.
    function memberOf(owner, vehicleId) {
      return allowed()
        && vehicleId is string
        && exists(/databases/$(database)/documents/users/$(owner)/vehicles/$(vehicleId)/members/$(request.auth.uid));
    }

    // The signed-in account's Google email, lowercased — only when Google has
    // verified it. An unverified address proves nothing about who holds it.
    function verifiedEmail() {
      return request.auth.token.email_verified == true
        && request.auth.token.email is string;
    }

    // A number that is a number (#79): not NaN — the one value not equal to
    // itself — and not either infinity. Firestore stores both as doubles, and
    // `is number` accepts them. Plain comparisons rather than `math.isNaN`,
    // which takes floats only, so an integer field would fail the check.
    // Bounded by JavaScript's largest safe integer (2^53 - 1; the rules have
    // no exponent notation): far above any honest value — a timestamp is
    // about 1.8e12 — and below where `+ 1` stops being exact.
    function finite(field) {
      return field is number && field == field
        && field <= 9007199254740991 && field >= -9007199254740991;
    }

    // How far ahead of the server's clock a merge stamp (`updatedAt`) may be
    // (#79): 31 days. The client adopts another device's stamp up to 30 days
    // ahead of its own clock (`MAX_ADOPTED_SKEW_MS`), so an honest device can
    // reach that; one more day is slack for a device whose own clock runs a
    // little fast. Must equal `MAX_ACCEPTED_AHEAD_MS` in `syncClock.ts` —
    // `rulesLimits.test.ts` reads this number out of this file.
    function maxAheadMs() { return 2678400000; }

    // An invitation (#66): `invites/{ownerUid}__{vehicleId}__{email}`. The id
    // is deterministic so a member rule can find it with one `exists()`, and
    // so one car cannot hold two invitations for the same address.
    match /invites/{inviteId} {
      allow read: if allowed()
        && (resource.data.ownerUid == request.auth.uid
            || (verifiedEmail() && resource.data.email == request.auth.token.email.lower()));
      allow create: if allowed()
        && request.resource.data.keys().hasOnly(['ownerUid', 'vehicleId', 'email', 'ownerName', 'vehicleName', 'createdAt'])
        && request.resource.data.keys().hasAll(['ownerUid', 'vehicleId', 'email', 'ownerName', 'vehicleName', 'createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.vehicleId is string
        && request.resource.data.vehicleId.size() > 0
        && request.resource.data.vehicleId.size() <= 200
        && request.resource.data.email is string
        && request.resource.data.email.size() > 2
        && request.resource.data.email.size() <= 320
        && request.resource.data.email == request.resource.data.email.lower()
        && request.resource.data.ownerName is string
        && request.resource.data.ownerName.size() <= 200
        && request.resource.data.vehicleName is string
        && request.resource.data.vehicleName.size() <= 200
        && finite(request.resource.data.createdAt)
        && inviteId == request.auth.uid + '__' + request.resource.data.vehicleId + '__' + request.resource.data.email
        // Only for a live car of your own.
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/vehicles/$(request.resource.data.vehicleId))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)/vehicles/$(request.resource.data.vehicleId)).data.deletedAt == null;
      // Withdrawn by the owner, or declined (or used up) by the invitee.
      allow delete: if allowed()
        && (resource.data.ownerUid == request.auth.uid
            || (verifiedEmail() && resource.data.email == request.auth.token.email.lower()));
    }

    match /users/{uid} {

      // Allowed through the door, and signed in as the owner of this path.
      // Both halves are tested on their own in rules.test.ts, because a single
      // test that fails for either reason proves neither.
      //
      // The null check inside allowed() is not redundant: an unauthenticated
      // request has request.auth == null, and reading .uid off null makes the
      // whole condition an error rather than a denial.
      function owner() {
        return allowed() && request.auth.uid == uid;
      }

      // The four fields every row carries, plus the document id matching the
      // record's own id — so a row cannot be filed under a name that disagrees
      // with its contents, which is the shape a merge would reconcile wrongly.
      function syncFields(id) {
        return request.resource.data.id is string
          && request.resource.data.id == id
          && request.resource.data.id.size() > 0
          && request.resource.data.id.size() <= 200
          // The merge stamp (#79). Last-write-wins means a stamp nobody can
          // beat locks a row for good — one a year ahead made a fill-up
          // impossible for anyone else to edit or delete. So: no further ahead
          // than an honest device can be, and never backwards. Equal is fine:
          // that is the same version sent again.
          && finite(request.resource.data.updatedAt)
          && request.resource.data.updatedAt <= request.time.toMillis() + maxAheadMs()
          && (resource == null || request.resource.data.updatedAt >= resource.data.updatedAt)
          && (request.resource.data.deletedAt == null
              || finite(request.resource.data.deletedAt))
          && request.resource.data.schemaVersion is number
          // The server's commit time, and only that (#52). Incremental sync
          // reads "everything stamped after my cursor", so a write without a
          // stamp — or with one the client chose — could be invisible to
          // every other device for good. An out-of-date copy of the app is
          // refused here, keeps its change locally, and sends it once updated.
          && request.resource.data.syncedAt == request.time;
      }

      function label(field, max) {
        return field is string && field.size() <= max;
      }

      function number(field) {
        return finite(field);
      }

      function optionalNumber(field) {
        return field == null || finite(field);
      }

      // Bounded well under the 1 MiB document cap, matching
      // MAX_SYNCED_RECEIPT_BYTES in firebase/remoteStore.ts. A receipt larger
      // than this is pushed without its image rather than rejected, so this
      // bound should never be hit by the app — it is here for everything that
      // is not the app.
      function receipt(field) {
        return field == null || (field is bytes && field.size() <= 716800);
      }

      // Measurements shared by fill-ups and submissions. Positivity is NOT
      // checked here: the draft gate owns that rule, it is tested there, and a
      // second copy in a language without tests would drift from it. Shape and
      // size are what rules are good at.
      function measurements() {
        return number(request.resource.data.date)
          && number(request.resource.data.odometer)
          && number(request.resource.data.gallons)
          && number(request.resource.data.pricePerGallon)
          && request.resource.data.isFullTank is bool
          && label(request.resource.data.fuelGrade, 40)
          && label(request.resource.data.station, 200)
          && label(request.resource.data.notes, 4000)
          && optionalNumber(request.resource.data.latitude)
          && optionalNumber(request.resource.data.longitude)
          && receipt(request.resource.data.receiptImageData);
      }

      allow read: if owner();

      match /vehicles/{id} {
        allow read: if owner() || memberOf(uid, id);
        allow write: if owner()
          && syncFields(id)
          && request.resource.data.keys().hasOnly([
            'id', 'updatedAt', 'deletedAt', 'schemaVersion', 'syncedAt',
            'name', 'make', 'model', 'year', 'createdAt'
          ])
          && request.resource.data.keys().hasAll([
            'id', 'updatedAt', 'deletedAt', 'schemaVersion', 'syncedAt',
            'name', 'make', 'model', 'year', 'createdAt'
          ])
          && label(request.resource.data.name, 200)
          && label(request.resource.data.make, 200)
          && label(request.resource.data.model, 200)
          && number(request.resource.data.year)
          && number(request.resource.data.createdAt);

        // Who the car is shared with (#66). Kept apart from the vehicle
        // record on purpose: the owner's sync pushes that record whole, last
        // write wins, and a member list inside it would be overwritten by any
        // device that had not yet seen someone join.
        match /members/{memberUid} {
          // The owner, the member themselves, and the other members — so a
          // shared car can say who logged each fill-up.
          allow read: if owner() || memberOf(uid, id);
          // Joining: only yourself, only with an invitation addressed to your
          // own verified email, and never into your own car — nor into a car
          // whose id names one of yours, live or deleted (#78). A car's id is
          // not secret and an owner can file a car under any id; joining such
          // a car would sync your own fill-ups into the inviter's account.
          allow create: if allowed()
            && request.auth.uid == memberUid
            && request.auth.uid != uid
            && verifiedEmail()
            && exists(/databases/$(database)/documents/invites/$(uid + '__' + id + '__' + request.auth.token.email.lower()))
            && !exists(/databases/$(database)/documents/users/$(request.auth.uid)/vehicles/$(id))
            && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'joinedAt'])
            && request.resource.data.keys().hasAll(['uid', 'name', 'email', 'joinedAt'])
            && request.resource.data.uid == memberUid
            && label(request.resource.data.name, 200)
            && request.resource.data.email == request.auth.token.email.lower()
            && number(request.resource.data.joinedAt);
          // Removed by the owner, or leaving.
          allow delete: if owner() || (allowed() && request.auth.uid == memberUid);
        }
      }

      // Cars shared *with* this account (#66): one document per car, written
      // by the member when they accept, so their other devices can find it.
      match /memberships/{membershipId} {
        allow read: if owner();
        allow delete: if owner();
        allow create, update: if owner()
          && request.resource.data.keys().hasOnly(['ownerUid', 'vehicleId', 'ownerName', 'vehicleName'])
          && request.resource.data.keys().hasAll(['ownerUid', 'vehicleId', 'ownerName', 'vehicleName'])
          && label(request.resource.data.ownerUid, 128)
          && label(request.resource.data.vehicleId, 200)
          && label(request.resource.data.ownerName, 200)
          && label(request.resource.data.vehicleName, 200)
          && membershipId == request.resource.data.ownerUid + '__' + request.resource.data.vehicleId;
      }

      match /fillUps/{id} {
        // The owner, or a member of **this fill-up's** car (#66). A member's
        // query must say `where vehicleId == <shared car>`, or it is refused.
        allow read: if owner() || memberOf(uid, resource.data.vehicleId);
        // A member writes fill-ups for the shared car only: a new one is
        // stamped with their own uid, and an edit (or a deletion, which is a
        // tombstone) can neither move it to another car nor change who
        // entered it.
        allow create: if !owner()
          && memberOf(uid, request.resource.data.vehicleId)
          && request.resource.data.get('enteredBy', null) == request.auth.uid
          && fillUpShape(id);
        allow update: if !owner()
          && memberOf(uid, resource.data.vehicleId)
          && memberOf(uid, request.resource.data.vehicleId)
          && request.resource.data.get('enteredBy', null) == resource.data.get('enteredBy', null)
          && fillUpShape(id);
        allow write: if owner()
          && fillUpShape(id);
      }

      function fillUpShape(id) {
        return syncFields(id)
          && request.resource.data.keys().hasOnly([
            'id', 'updatedAt', 'deletedAt', 'schemaVersion', 'syncedAt', 'vehicleId',
            'date', 'odometer', 'gallons', 'pricePerGallon', 'isFullTank',
            'missedPreviousFillUp', 'fuelGrade', 'station', 'notes',
            'latitude', 'longitude', 'receiptImageData', 'enteredBy'
          ])
          && request.resource.data.keys().hasAll([
            'id', 'updatedAt', 'deletedAt', 'schemaVersion', 'syncedAt', 'vehicleId',
            'date', 'odometer', 'gallons', 'pricePerGallon', 'isFullTank',
            'missedPreviousFillUp', 'fuelGrade', 'station', 'notes',
            'latitude', 'longitude', 'receiptImageData'
          ])
          && label(request.resource.data.vehicleId, 200)
          && request.resource.data.vehicleId.size() > 0
          && request.resource.data.missedPreviousFillUp is bool
          // Who logged it (#66): optional, so an older build can still write.
          && (request.resource.data.get('enteredBy', null) == null
              || label(request.resource.data.enteredBy, 128))
          && measurements();
      }

      match /pendingFillUps/{id} {
        allow read: if owner();
        allow write: if owner()
          && syncFields(id)
          && request.resource.data.keys().hasOnly([
            'id', 'updatedAt', 'deletedAt', 'schemaVersion', 'syncedAt', 'vehicleId',
            'submittedAt', 'submitterName', 'date', 'odometer', 'gallons',
            'pricePerGallon', 'isFullTank', 'fuelGrade', 'station', 'notes',
            'latitude', 'longitude', 'receiptImageData'
          ])
          && request.resource.data.keys().hasAll([
            'id', 'updatedAt', 'deletedAt', 'schemaVersion', 'syncedAt', 'vehicleId',
            'submittedAt', 'submitterName', 'date', 'odometer', 'gallons',
            'pricePerGallon', 'isFullTank', 'fuelGrade', 'station', 'notes',
            'latitude', 'longitude', 'receiptImageData'
          ])
          && label(request.resource.data.vehicleId, 200)
          && request.resource.data.vehicleId.size() > 0
          && number(request.resource.data.submittedAt)
          && label(request.resource.data.submitterName, 200)
          && measurements();
      }
    }
  }
}
