{
  "name": "fueltracker-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run --project unit --project dom",
    "test:build": "vite build && vitest run --project build",
    "test:rules": ".github/firebase-cli/node_modules/.bin/firebase emulators:exec --only firestore --project fueltracker-rules-test \"vitest run --project rules\"",
    "test:watch": "vitest --project unit --project dom",
    "typecheck": "tsc -b",
    "mutate": "node --experimental-strip-types scripts/mutations/mutate.ts",
    "mutate:check": "node --experimental-strip-types scripts/mutations/mutate.ts --check",
    "lint": "oxlint -c .oxlintrc.json --deny-warnings src scripts vite.config.ts"
  },
  "engines": {
    "node": "^22"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.0",
    "oxlint": "^1.91.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.5"
  },
  "description": "Track gas fill-ups and fuel economy in your browser. Works offline; syncs to your Google account.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/kja031199/fueltracker-web.git"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "dexie": "^4.4.6",
    "exifr": "^7.1.3",
    "firebase": "^13.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0"
  }
}
