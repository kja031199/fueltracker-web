{
  "title": "#100 One home per fact, and a short manual",
  "tests": [
    "src/test/docs.test.ts"
  ],
  "mutations": [
    {
      "name": "a copy of the docs index back in the README",
      "file": "README.md",
      "from": "## Documentation\n",
      "to": "## Documentation\n\n| [docs/port.md](docs/port.md) | The port |\n"
    },
    {
      "name": "a doc missing from the index",
      "file": "docs/README.md",
      "from": "- **[csp-check.md](csp-check.md)**",
      "to": "- **csp-check.md**"
    },
    {
      "name": "a command missing from the command list",
      "file": "docs/development.md",
      "from": "npm run mutate        # every recorded mutation; `mutate:check` only checks they apply\n",
      "to": ""
    },
    {
      "name": "CLAUDE.md no longer says how to list the rules",
      "file": "CLAUDE.md",
      "from": "```bash\ngit grep -n '@trap'\n```",
      "to": "```bash\ngit grep -n\n```"
    },
    {
      "name": "CLAUDE.md grows past 160 lines",
      "file": "CLAUDE.md",
      "from": "## Checks\n",
      "to": "## Checks\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n"
    },
    {
      "name": "a rule that names no issue",
      "file": "src/data/sync.ts",
      "from": " * @trap #42 — ",
      "to": " * @trap — "
    },
    {
      "name": "a rule tagged with no real issue number",
      "file": "src/test/setup.ts",
      "from": " * @trap #56 — ",
      "to": " * @trap #0 — "
    },
    {
      "name": "a rule untagged, so the grep no longer finds it",
      "file": "docs/development.md",
      "from": "- **@trap #37 — `userEvent.setup()`",
      "to": "- **`userEvent.setup()`"
    }
  ]
}
